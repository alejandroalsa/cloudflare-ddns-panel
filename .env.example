# Variables opcionales para docker-compose.yml — Compose las lee automáticamente
# de este archivo si existe. No son necesarias para que el proyecto funcione;
# solo permiten cambiar puertos sin tocar docker-compose.yml.

# Puerto en el que se sirve el panel web (Nginx + frontend)
FRONTEND_PORT=80

# Puerto en el que se expone la API directamente (útil para depurar con curl/Postman).
# Si no quieres exponerlo a Internet, puedes quitar el bloque "ports" del backend
# en docker-compose.yml y esta variable dejará de usarse.
BACKEND_PORT=8000
