# Copia este archivo a /etc/nginx/sites-available/ddns-panel y crea el symlink
# en /etc/nginx/sites-enabled/. Ajusta server_name y la ruta de dist/.

server {
    listen 80;
    server_name ddns-panel.tu-dominio.com;

    root /opt/cloudflare-ddns-panel/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
