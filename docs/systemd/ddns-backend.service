[Unit]
Description=Cloudflare DDNS Panel - Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cloudflare-ddns-panel/backend
Environment="PATH=/opt/cloudflare-ddns-panel/backend/venv/bin"
EnvironmentFile=/opt/cloudflare-ddns-panel/backend/.env
ExecStart=/opt/cloudflare-ddns-panel/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
