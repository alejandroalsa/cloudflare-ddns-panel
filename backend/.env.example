# Base de datos (SQLite por defecto, se crea sola en ./data/ddns.db)
DATABASE_URL=sqlite:///./data/ddns.db

# Seguridad - CAMBIA ESTO en producción
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Usuario admin creado automáticamente la primera vez que arranca la app
# (solo si la tabla de usuarios está vacía). Cámbialo tras el primer login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:80
